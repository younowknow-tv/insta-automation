# Sarvam AI — https://dashboard.sarvam.ai  (₹100 free credit ≈ 33k characters ≈ 30 videos)
SARVAM_API_KEY=
SARVAM_SPEAKER=shreya
SARVAM_MODEL=bulbul:v3
SARVAM_PACE=1.1          # v3 accepts 0.5-2.0

# Pexels — https://www.pexels.com/api/  (free, instant)
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/api/docs/  (free, instant)
PIXABAY_API_KEY=

# Install Noto Sans Devanagari, or set this to a font you have
# (macOS ships "Kohinoor Devanagari")
CAPTION_FONT=Noto Sans Devanagari

# --- Instagram publishing (Phase 2) ---
# developers.facebook.com -> Create app -> "Instagram" use case -> API setup with
# Instagram login. Creator account, no Facebook Page, no App Review needed.
IG_APP_ID=
IG_APP_SECRET=

# Instagram fetches the MP4 from a public URL; it does not accept uploads.
# "github" parks it as a release asset (needs: brew install gh && gh auth login).
# The repo must be PUBLIC or Meta gets a 404.
VIDEO_HOST=github
PUBLISH_REPO=
PUBLISH_TAG=reels
